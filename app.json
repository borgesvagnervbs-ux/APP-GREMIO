{
  "expo": {
    "name": "Tricolor em Dia",
    "slug": "app-gremio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a1a2c"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a1a2c"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro",
      "name": "Tricolor em Dia",
      "shortName": "Tricolor",
      "themeColor": "#0a1a2c",
      "backgroundColor": "#0a1a2c",
      "lang": "pt-BR"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser"
    ],
    "scheme": "tricoloremdia",
    "experiments": {
      "baseUrl": "/APP-GREMIO",
      "typedRoutes": false
    }
  }
}
